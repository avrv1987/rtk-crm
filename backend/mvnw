#!/usr/bin/env sh
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_VERSION=3.9.16
MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_CACHE="$MAVEN_USER_HOME/wrapper/dists/apache-maven-$MAVEN_VERSION"
MAVEN_HOME="$MAVEN_CACHE/apache-maven-$MAVEN_VERSION"
ARCHIVE="$MAVEN_CACHE/apache-maven-$MAVEN_VERSION-bin.zip"
URL=https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.16/apache-maven-3.9.16-bin.zip
SHA512=ed41650d42485cfc243fad22158caf9cbb5dc408ce7a09ddb94dd42a019de929ca43065bfa450612cf12bf78b5cafa3884b96c090de326ff590448c933454af3

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  mkdir -p "$MAVEN_CACHE"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --proto '=https' --tlsv1.2 "$URL" --output "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget --https-only --output-document="$ARCHIVE" "$URL"
  else
    echo "curl or wget is required to download Maven $MAVEN_VERSION" >&2
    exit 1
  fi
  if command -v sha512sum >/dev/null 2>&1; then
    ACTUAL=$(sha512sum "$ARCHIVE" | awk '{print $1}')
  elif command -v shasum >/dev/null 2>&1; then
    ACTUAL=$(shasum -a 512 "$ARCHIVE" | awk '{print $1}')
  else
    echo "sha512sum or shasum is required to verify Maven $MAVEN_VERSION" >&2
    exit 1
  fi
  if [ "$ACTUAL" != "$SHA512" ]; then
    rm -f "$ARCHIVE"
    echo "Maven $MAVEN_VERSION checksum verification failed" >&2
    exit 1
  fi
  unzip -q "$ARCHIVE" -d "$MAVEN_CACHE"
fi

exec "$MAVEN_HOME/bin/mvn" -Dmaven.multiModuleProjectDirectory="$BASE_DIR" "$@"
