{
  "name": "rtk-crm-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../backend/src/main/resources/static/openapi.yaml -o src/shared/api/openapi.d.ts",
    "typecheck": "npm run generate:api && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --test tests/draftBase.test.ts tests/help.test.ts tests/deadlines.test.ts tests/datetime.test.ts tests/routing.test.ts tests/lmsStageSuggestion.test.ts tests/reportPeriods.test.ts tests/signingPlan.test.ts tests/organizationHistory.test.ts tests/learningRun.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
