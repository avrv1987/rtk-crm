    <element xsi:type="archimate:Grouping" name="Профиль Compose core (без метки)" id="id-5b4b390e981d421c60ca407305acf401">
      <documentation>web, backend, postgres, keycloak: запускаются всегда.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Профиль Compose security" id="id-ca361671558a82b23970eca68497ccbd">
