    </element>
    <element xsi:type="archimate:Artifact" name="infra/keycloak/rtk-crm-realm.json" id="id-0581f950c536834fc1fca25b9bdaa908"/>
    <element xsi:type="archimate:Artifact" name="infra/clamav/clamd.conf" id="id-3aca4857ff794854568ae9e8b3aba948"/>
    <element xsi:type="archimate:Artifact" name="infra/postgres/init/00-create-databases-and-roles.sh" id="id-f42726c47ca9afceff093e22202fdb70"/>
    <element xsi:type="archimate:Artifact" name="Том postgres-data" id="id-aaad469b94be6962bb36bfe6b1769d41"/>
    <element xsi:type="archimate:Artifact" name="Том attachments-data (/var/lib/rtk-crm/files)" id="id-23f270a2bd7e2344365f02f11bc652c3"/>
