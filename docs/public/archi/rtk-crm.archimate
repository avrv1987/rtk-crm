    <element xsi:type="archimate:Artifact" name="frontend/dist (сборка SPA)" id="id-be1e8cc643e987d014b36ff4c2693b49"/>
    <element xsi:type="archimate:Artifact" name="infra/web/default.conf, crm-site.conf" id="id-fd9790f36b620efb6d8ca741d5f03149"/>
